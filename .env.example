DATABASE_URL=
NEON_AUTH_BASE_URL=
# Optional: used for any user who hasn't configured their own key in Settings.
# Leave blank to require every account to bring its own key.
PLATFORM_API_KEY=
PLATFORM_GROQ_API_KEY=

# Instagram gates some posts behind a login, and view/reshare counts are only
# readable from a logged-in session at all. Supply cookies from one. Either
# export a Netscape cookies.txt and point at it, or (local dev only) read them
# straight from an installed browser.
# If neither is set, data/cookies.txt is picked up automatically when present.
#
# Use a throwaway account, not one you care about: this is automated traffic
# against Instagram's private web API, which is what rate limiting and account
# suspensions exist to catch.
YTDLP_COOKIES_FILE=
# Deployed with env vars only (Hostinger Docker project etc.)? Paste the whole
# cookies.txt here instead - raw, or base64-encoded - and it is written to
# data/cookies.txt on startup.
YTDLP_COOKIES_CONTENT=
# e.g. chrome | firefox | edge | "chrome:Profile 1"
YTDLP_COOKIES_FROM_BROWSER=

# Optional but strongly recommended when reading cookies from a browser: the
# numeric ds_user_id of the ONLY account this app may act as. Reading live from a
# browser means the app follows whoever is logged in there, so without this a
# later login as a different account silently starts using it. With it set, the
# app refuses to download or fetch counts under any other account.
# Find it by logging in and reading the ds_user_id cookie for instagram.com.
INSTAGRAM_ACCOUNT_ID=

# Performance tiers for formula analysis, in views. Absolute, not relative:
# amazing >= AMAZING_VIEW_THRESHOLD, good >= GOOD_VIEW_THRESHOLD, low below that.
# Defaults suit large creators; lower them for a smaller account.
GOOD_VIEW_THRESHOLD=50000
AMAZING_VIEW_THRESHOLD=1000000

# Reach-multiple bands (views / creator follower count), used when a project's
# "how did well is decided" setting is Reach multiple. 3x = clearly travelled past
# the existing audience; under 0.3x = barely reached the followers it already had.
REACH_BREAKOUT_MULTIPLE=3.0
REACH_ABOVE_MULTIPLE=1.0
REACH_BASELINE_MULTIPLE=0.3

# Optional platform-wide search key for the agent's web_research tool, used when
# an account hasn't set its own in Settings. First one set wins, in this order.
TAVILY_API_KEY=
LANGSEARCH_API_KEY=
BRAVE_API_KEY=

# Server binding (local dev only; the Docker image runs gunicorn on 0.0.0.0:5151).
# HOST=0.0.0.0 makes a local run reachable from other machines on the network.
HOST=127.0.0.1
PORT=5151
